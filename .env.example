# Copia este archivo a `.env` (raíz del proyecto) y a `web/.env.local` para desarrollo.

# ── Base de datos ─────────────────────────────────────────────
# Desarrollo en el Mac: si DATABASE_URL está vacío se usa PGlite (Postgres embebido en ./web/.data)
DATABASE_URL=
POSTGRES_USER=hogar
POSTGRES_PASSWORD=cambia-esto
POSTGRES_DB=hogar

# ── Acceso al dashboard (2 usuarios) ──────────────────────────
# PIN compartido para entrar desde el móvil (además de Tailscale)
DASHBOARD_PIN=
SESSION_SECRET=genera-una-cadena-larga-aleatoria

# ── Familia ───────────────────────────────────────────────────
TZ=Europe/Madrid
# Coordenadas para el tiempo (Open-Meteo, sin API key)
WEATHER_LAT=40.9701
WEATHER_LON=-5.6635
WEATHER_PLACE=Salamanca

# ── IA local (LM Studio / llama.cpp, API compatible OpenAI) ───
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=qwen3-8b
# Opcional: modo nube solo para tareas pesadas (fotos de tickets). Vacío = desactivado
GEMINI_API_KEY=

# ── Telegram ──────────────────────────────────────────────────
# Crea el bot con @BotFather. Chat ID: el del grupo "Casa" con los dos + el bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# IDs de usuario autorizados (separados por coma) — el bot ignora a cualquier otro
TELEGRAM_ALLOWED_USERS=

# ── Briefings (cron, hora local) ──────────────────────────────
BRIEFING_EVENING_CRON=30 21 * * *
BRIEFING_MORNING_CRON=0 7 * * *

# ── Integraciones (n8n → API del dashboard) ───────────────────
INGEST_TOKEN=genera-otro-token-para-n8n
